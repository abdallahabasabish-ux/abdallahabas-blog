---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { SITE } from "@/lib/config";
import { breadcrumbSchema } from "@/lib/seo";

const posts = (await getCollection("posts", (p) => p.data.status === "published"))
  .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);

const schemas = [
  breadcrumbSchema([
    { name: "الرئيسية", url: "/" },
    { name: "المقالات", url: "/blog" },
  ]),
];
---
<BaseLayout title="جميع المقالات" description="كل مقالات مدونة عبد الله عباس في مكان واحد." path="/blog" schemas={schemas}>
  <section class="container-blog pt-12 md:pt-16">
    <header class="max-w-2xl">
      <p class="text-sm font-semibold text-brand-600">المدونة</p>
      <h1 class="mt-2 text-3xl font-bold text-ink-900 md:text-4xl">جميع المقالات</h1>
      <p class="mt-3 text-ink-500">
        {posts.length} مقالًا في التسويق الرقمي، تطوير الأعمال، والهوية الرقمية.
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="mt-12 rounded-2xl border border-dashed border-ink-200 p-12 text-center text-ink-500">
        لا توجد مقالات منشورة بعد.
      </p>
    ) : (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    )}
  </section>
</BaseLayout>
