---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import Faq from "@/components/Faq.astro";
import StoreCta from "@/components/StoreCta.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import Icon from "@/components/Icon.astro";
import { formatDateAr, readingTimeAr } from "@/lib/utils";
import { SITE } from "@/lib/config";
import { articleSchema, breadcrumbSchema, faqSchema } from "@/lib/seo";
import { getRelated } from "@/lib/related";

export async function getStaticPaths() {
  const posts = await getCollection("posts", (p) => p.data.status === "published");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const { data } = post;

const url = `/blog/${post.id}`;
const readingTime = readingTimeAr(remarkPluginFrontmatter?.plainText ?? data.excerpt);
const related = await getRelated(post, 3);

const crumbs = [
  { name: "الرئيسية", url: "/" },
  { name: "المقالات", url: "/blog" },
  { name: data.category.data.name, url: `/category/${data.category.data.slug}` },
  { name: data.title, url },
];

const schemas = [
  articleSchema({
    ...data,
    slug: post.id,
    author: { id: data.author.id, name: data.author.data.name },
  }),
  breadcrumbSchema(crumbs),
  faqSchema(data.faq),
].filter(Boolean);
---
<BaseLayout
  title={data.metaTitle ?? data.title}
  description={data.metaDescription ?? data.excerpt}
  path={url}
  image={data.ogImage ?? data.cover}
  canonical={data.canonicalUrl}
  type="article"
  publishedTime={data.publishedAt.toISOString()}
  modifiedTime={(data.updatedAt ?? data.publishedAt).toISOString()}
  noindex={data.noindex}
  schemas={schemas}
>
  <article class="container-blog pt-10 md:pt-14">
    <Breadcrumbs items={crumbs} />

    <header class="mx-auto mt-6 max-w-3xl text-center">
      <a href={`/category/${data.category.data.slug}`}
        class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-bold text-brand-700 hover:bg-brand-100">
        {data.category.data.name}
      </a>
      <h1 class="mt-4 text-3xl font-bold leading-[1.3] text-ink-900 md:text-5xl md:leading-[1.25]">
        {data.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-500">{data.excerpt}</p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-ink-500">
        <a href={`/author/${data.author.id}`} class="inline-flex items-center gap-2 font-medium text-ink-700 hover:text-brand-600">
          <img src={data.author.data.avatar} alt="" width="28" height="28" class="h-7 w-7 rounded-full object-cover" />
          {data.author.data.name}
        </a>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="calendar" size={14} /> {formatDateAr(data.publishedAt)}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="clock" size={14} /> {readingTime} د قراءة
        </span>
      </div>
    </header>

    {data.cover && (
      <figure class="mx-auto mt-10 max-w-4xl">
        <img
          src={data.cover}
          alt={data.coverAlt}
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-[16/9] w-full rounded-2xl object-cover ring-1 ring-ink-100"
        />
      </figure>
    )}

    <div class="mx-auto mt-12 grid max-w-5xl gap-10 lg:grid-cols-[1fr_260px]">
      <div class="min-w-0">
        <div class="prose-ar">
          <Content />
        </div>

        {data.faq?.length > 0 && <Faq items={data.faq} />}

        {data.tags?.length > 0 && (
          <div class="mt-10 flex flex-wrap items-center gap-2">
            <span class="text-sm font-semibold text-ink-700">الوسوم:</span>
            {data.tags.map((t) => (
              <span class="inline-flex items-center gap-1 rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-700">
                <Icon name="tag" size={12} /> {t}
              </span>
            ))}
          </div>
        )}

        <StoreCta />
        <RelatedPosts posts={related} />

        <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-ink-100 pt-6">
          <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:underline">
            <Icon name="arrowRight" size={16} /> العودة إلى المقالات
          </a>
        </div>
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        {data.toc && <TableOfContents headings={headings} />}
      </aside>
    </div>
  </article>
</BaseLayout>
