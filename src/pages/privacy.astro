---
// src/pages/privacy.astro
import BaseLayout from "@/layouts/BaseLayout.astro";
import { breadcrumbSchema } from "@/lib/seo";

const crumbs = [
  { name: "الرئيسية", url: "/" },
  { name: "سياسة الخصوصية", url: "/privacy" },
];
---
<BaseLayout title="سياسة الخصوصية" description="سياسة الخصوصية لمدونة عبد الله عباس." path="/privacy"
  schemas={[breadcrumbSchema(crumbs)]}>
  <article class="container-blog pt-12 md:pt-16">
    <div class="prose-ar mx-auto max-w-3xl">
      <h1>سياسة الخصوصية</h1>
      <p class="text-sm text-ink-500">آخر تحديث: —</p>

      <h2>المعلومات التي نجمعها</h2>
      <p>لا نجمع أي بيانات شخصية عند تصفح المدونة. قد تُجمع بيانات تحليلية مجهولة الهوية عند تفعيل خدمة إحصاءات مستقبلًا.</p>

      <h2>ملفات تعريف الارتباط</h2>
      <p>لا نستخدم ملفات تعريف ارتباط تتبّع. راجع <a href="/cookies">سياسة ملفات تعريف الارتباط</a>.</p>

      <h2>الروابط الخارجية</h2>
      <p>قد تحتوي المدونة على روابط لمواقع خارجية. لسنا مسؤولين عن سياسات الخصوصية لتلك المواقع.</p>

      <h2>التعديلات</h2>
      <p>قد نحدّث هذه السياسة من وقت لآخر. سيظهر تاريخ آخر تحديث في الأعلى.</p>

      <h2>التواصل</h2>
      <p>لأي استفسار: <a href="/contact">صفحة التواصل</a>.</p>
    </div>
  </article>
</BaseLayout>
