---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/lib/config";
import { personSchema, breadcrumbSchema } from "@/lib/seo";

const author = (await getCollection("authors"))[0];
const posts = await getCollection("posts", (p) => p.data.status === "published");

const crumbs = [
  { name: "الرئيسية", url: "/" },
  { name: "من أنا", url: "/about" },
];
---
<BaseLayout
  title="من أنا"
  description={`تعرّف على ${SITE.name} — ${SITE.description}`}
  path="/about"
  schemas={[personSchema({ ...author.data, id: author.id }), breadcrumbSchema(crumbs)]}
>
  <article class="container-blog pt-12 md:pt-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-3xl border border-ink-100 bg-white p-6 text-center">
          <img src={author.data.avatar} alt={author.data.name} width="140" height="140"
            class="mx-auto h-32 w-32 rounded-2xl object-cover ring-4 ring-brand-50" />
          <h2 class="mt-5 text-xl font-bold text-ink-900">{author.data.name}</h2>
          {author.data.expertise.length > 0 && (
            <p class="mt-1 text-sm text-brand-600 font-medium">
              {author.data.expertise.join(" · ")}
            </p>
          )}
          <div class="mt-5 flex flex-wrap justify-center gap-2">
            {author.data.website && (
              <a href={author.data.website} target="_blank" rel="noopener"
                class="inline-flex items-center gap-1 rounded-lg bg-ink-900 px-3 py-2 text-xs font-bold text-white hover:bg-brand-600">
                الموقع <Icon name="external" size={12} />
              </a>
            )}
            <a href="/contact" class="rounded-lg bg-brand-500 px-3 py-2 text-xs font-bold text-white hover:bg-brand-600">
              تواصل
            </a>
          </div>
          <p class="mt-5 text-xs text-ink-500">
            {posts.length} مقالًا منشورًا
          </p>
        </div>
      </aside>

      <div class="prose-ar">
        <p class="text-sm font-semibold text-brand-600 not-prose">من أنا</p>
        <h1 class="text-3xl font-bold text-ink-900 md:text-4xl mt-2">
          مرحبًا، أنا {SITE.name}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-ink-700">
          {author.data.bio}
        </p>
        <p>
          أشارك في هذه المدونة خبرتي العملية في التسويق الرقمي، تطوير الأعمال، وبناء الهوية الرقمية — بتركيز على حلول قابلة للتطبيق فورًا في السياق العربي.
        </p>
        <p>
          هدفي أن تقدّم لك كل مقالة قيمة حقيقية: خطوات واضحة، أمثلة عملية، وأدوات مجرّبة.
        </p>

        <StoreCtaInline />
      </div>
    </div>
  </article>
</BaseLayout>

<!-- مكوّن مضمّن بسيط للـ CTA داخل about -->
<script is:inline></script>
