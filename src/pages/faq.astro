---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Faq from "@/components/Faq.astro";
import { faqSchema, breadcrumbSchema } from "@/lib/seo";

const items = [
  { q: "كيف أتصفح المقالات؟", a: "يمكنك تصفح المقالات من صفحة «المقالات» أو من خلال التصنيفات، أو استخدام البحث في الأعلى." },
  { q: "هل المحتوى مجاني؟", a: "نعم، جميع المقالات متاحة مجانًا. الخدمات الاحترافية متوفرة على الموقع الرئيسي." },
  { q: "كيف أتواصل معك؟", a: "عبر صفحة «تواصل معي» أو البريد الإلكتروني المذكور فيها." },
];

const schemas = [
  faqSchema(items),
  breadcrumbSchema([
    { name: "الرئيسية", url: "/" },
    { name: "الأسئلة الشائعة", url: "/faq" },
  ]),
].filter(Boolean);
---
<BaseLayout title="الأسئلة الشائعة" description="الأسئلة الشائعة حول المدونة والخدمات." path="/faq" schemas={schemas}>
  <section class="container-blog pt-12 md:pt-16">
    <header class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl font-bold text-ink-900 md:text-4xl">الأسئلة الشائعة</h1>
    </header>
    <div class="mx-auto mt-10 max-w-2xl">
      <Faq items={items} />
    </div>
  </section>
</BaseLayout>
