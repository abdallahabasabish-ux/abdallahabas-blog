---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="البحث" description="ابحث في مقالات مدونة عبد الله عباس." path="/search" noindex>
  <section class="container-blog pt-12 md:pt-16">
    <header class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl font-bold text-ink-900 md:text-4xl">البحث في المدونة</h1>
      <p class="mt-3 text-ink-500">ابحث في عناوين المقالات، محتواها، تصنيفاتها، ووسومها.</p>
    </header>

    <form id="search-form" class="mx-auto mt-8 max-w-2xl" role="search">
      <label for="q" class="sr-only">كلمة البحث</label>
      <div class="relative">
        <input
          id="q"
          name="q"
          type="search"
          required
          placeholder="اكتب كلمة البحث..."
          class="w-full rounded-2xl border border-ink-200 bg-white px-5 py-4 pe-14 text-base outline-none transition-colors focus:border-brand-500"
          autocomplete="off"
        />
        <button type="submit" aria-label="ابحث"
          class="absolute inset-y-0 end-2 my-2 grid w-11 place-items-center rounded-xl bg-brand-500 text-white hover:bg-brand-600">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
          </svg>
        </button>
      </div>
    </form>

    <div class="mx-auto mt-10 max-w-3xl">
      <p id="search-meta" class="mb-4 text-sm text-ink-500" hidden></p>
      <div id="results" class="space-y-3"></div>
      <div id="empty" hidden class="rounded-2xl border border-dashed border-ink-200 p-12 text-center">
        <p class="text-lg font-semibold text-ink-900">لا توجد نتائج مطابقة</p>
        <p class="mt-2 text-sm text-ink-500">جرّب كلمات أعم أو تحقق من الإملاء.</p>
      </div>
    </div>
  </section>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline>
    (async () => {
      const form = document.getElementById("search-form");
      const input = document.getElementById("q");
      const out = document.getElementById("results");
      const empty = document.getElementById("empty");
      const meta = document.getElementById("search-meta");

      // جلب كلمة البحث من الرابط
      const params = new URLSearchParams(location.search);
      const initial = params.get("q");
      if (initial) input.value = initial;

      let pagefind;
      try {
        pagefind = await import("/pagefind/pagefind.js");
        await pagefind.init();
      } catch (e) {
        meta.hidden = false;
        meta.textContent = "البحث يعمل بعد النشر الأول على GitHub Pages.";
        return;
      }

      const render = (results, q) => {
        out.innerHTML = "";
        meta.hidden = false;
        meta.textContent = `عدد النتائج: ${results.length} — البحث عن: «${q}»`;
        empty.hidden = results.length > 0;

        for (const r of results.slice(0, 25)) {
          const d = await r.data();
          const a = document.createElement("a");
          a.href = d.url;
          a.className = "block rounded-2xl border border-ink-100 bg-white p-5 transition-all hover:border-brand-300 hover:shadow-[var(--shadow-soft)]";
          a.innerHTML = `
            <h2 class="text-lg font-bold text-ink-900">${d.meta.title ?? ""}</h2>
            <p class="mt-1 text-sm text-ink-500 clamp-2">${d.excerpt ?? ""}</p>
          `;
          out.appendChild(a);
        }
      };

      const run = async (q) => {
        if (!q) return;
        const res = await pagefind.search(q);
        render(res.results, q);
      };

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const q = input.value.trim();
        if (!q) return;
        history.replaceState(null, "", `/search?q=${encodeURIComponent(q)}`);
        run(q);
      });

      if (initial) run(initial);
    })();
  </script>
</BaseLayout>
