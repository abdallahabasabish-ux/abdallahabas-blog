---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="البحث" description="ابحث في مقالات المدونة">
  <section class="container mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold mb-6">البحث في المدونة</h1>

    <form id="search-form" class="mb-8">
      <input id="q" type="search" placeholder="اكتب كلمة البحث..."
        class="w-full rounded-xl border border-ink-200 px-4 py-3 text-lg focus:border-brand-500 focus:outline-none" />
    </form>

    <div id="results"></div>
    <div id="empty" hidden class="text-center py-16">
      <p class="text-ink-500 text-lg">لا توجد نتائج مطابقة.</p>
    </div>
  </section>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script>
    import "/pagefind/pagefind-ui.js";
    window.addEventListener("DOMContentLoaded", async () => {
      const pf = await import("/pagefind/pagefind.js");
      await pf.init();
      const form = document.getElementById("search-form");
      const input = document.getElementById("q");
      const out = document.getElementById("results");
      const empty = document.getElementById("empty");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const q = input.value.trim();
        if (!q) return;
        const res = await pf.search(q);
        out.innerHTML = "";
        empty.hidden = res.results.length > 0;
        for (const r of res.results.slice(0, 20)) {
          const d = await r.data();
          const a = document.createElement("a");
          a.href = d.url;
          a.className = "block rounded-xl border border-ink-100 p-4 mb-3 hover:border-brand-300";
          a.innerHTML = `<h3 class="font-semibold text-lg">${d.meta.title}</h3>
                         <p class="text-ink-500 text-sm mt-1">${d.excerpt}</p>`;
          out.appendChild(a);
        }
      });
    });
  </script>
</BaseLayout>
