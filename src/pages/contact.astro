---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/lib/config";

const crumbs = [
  { name: "الرئيسية", url: "/" },
  { name: "تواصل معي", url: "/contact" },
];
---
<BaseLayout title="تواصل معي" description="تواصل مع عبد الله عباس." path="/contact">
  <section class="container-blog pt-12 md:pt-16">
    <header class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-brand-600">تواصل</p>
      <h1 class="mt-2 text-3xl font-bold text-ink-900 md:text-4xl">تواصل معي</h1>
      <p class="mt-3 text-ink-500">
        لأي استفسار حول الخدمات، التعاون، أو المحتوى — يسعدني سماعك.
      </p>
    </header>

    <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
      <a href="mailto:hello@abdallahabas.com"
        class="group rounded-2xl border border-ink-100 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-[var(--shadow-soft)]">
        <div class="grid h-11 w-11 place-items-center rounded-xl bg-brand-50 text-brand-600">
          <Icon name="mail" size={22} />
        </div>
        <h2 class="mt-4 font-bold text-ink-900 group-hover:text-brand-600">البريد الإلكتروني</h2>
        <p class="mt-1 text-sm text-ink-500">hello@abdallahabas.com</p>
      </a>

      <a href={SITE.mainSite} target="_blank" rel="noopener"
        class="group rounded-2xl border border-ink-100 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-[var(--shadow-soft)]">
        <div class="grid h-11 w-11 place-items-center rounded-xl bg-brand-50 text-brand-600">
          <Icon name="external" size={22} />
        </div>
        <h2 class="mt-4 font-bold text-ink-900 group-hover:text-brand-600">الموقع الرئيسي</h2>
        <p class="mt-1 text-sm text-ink-500">abdallahabas.com</p>
      </a>
    </div>

    <div class="mx-auto mt-10 max-w-4xl rounded-2xl border border-brand-200 bg-brand-50 p-6 text-center">
      <p class="text-sm text-ink-700">
        <strong class="font-bold">ملاحظة:</strong> نموذج التواصل المباشر غير مفعّل حاليًا.
        سيتم تفعيله عند ربط المدونة بخدمة خارجية (مثل Cloudflare Workers أو Formspree).
        في الوقت الحالي، راسلني عبر البريد الإلكتروني مباشرة.
      </p>
    </div>
  </section>
</BaseLayout>
