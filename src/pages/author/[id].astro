---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Icon from "@/components/Icon.astro";
import { personSchema, breadcrumbSchema } from "@/lib/seo";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  return authors.map((author) => ({ params: { id: author.id }, props: { author } }));
}

const { author } = Astro.props;
const { data } = author;
const posts = (await getCollection("posts",
  (p) => p.data.status === "published" && p.data.author.id === author.id
)).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);

const crumbs = [
  { name: "الرئيسية", url: "/" },
  { name: data.name, url: `/author/${author.id}` },
];
---
<BaseLayout title={data.name} description={data.bio} path={`/author/${author.id}`}
  schemas={[personSchema({ ...data, id: author.id }), breadcrumbSchema(crumbs)]}
  image={data.avatar}
>
  <section class="container-blog pt-12 md:pt-16">
    <header class="rounded-3xl border border-ink-100 bg-ink-50/50 p-8 md:p-12">
      <div class="flex flex-col items-start gap-6 md:flex-row md:items-center">
        <img src={data.avatar} alt={data.name} width="120" height="120"
          class="h-28 w-28 rounded-2xl object-cover ring-4 ring-white" />
        <div class="flex-1">
          <h1 class="text-3xl font-bold text-ink-900">{data.name}</h1>
          <p class="mt-3 max-w-2xl leading-relaxed text-ink-500">{data.bio}</p>

          {data.expertise.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {data.expertise.map((e) => (
                <li class="inline-flex items-center gap-1 rounded-full bg-white px-3 py-1 text-xs font-semibold text-ink-700 ring-1 ring-ink-200">
                  <Icon name="check" size={12} class="text-brand-600" /> {e}
                </li>
              ))}
            </ul>
          )}

          <div class="mt-5 flex flex-wrap gap-3">
            {data.website && (
              <a href={data.website} target="_blank" rel="noopener"
                class="inline-flex items-center gap-1.5 rounded-xl bg-ink-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-600">
                الموقع الشخصي <Icon name="external" size={14} />
              </a>
            )}
            {Object.entries(data.social).filter(([, v]) => v).map(([k, v]) => (
              <a href={String(v)} target="_blank" rel="noopener"
                class="rounded-xl bg-white px-4 py-2.5 text-sm font-bold text-ink-900 ring-1 ring-ink-200 hover:ring-brand-500 hover:text-brand-600 capitalize">
                {k}
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <h2 class="mt-14 mb-6 text-2xl font-bold text-ink-900">
      مقالات {data.name} ({posts.length})
    </h2>

    {posts.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-ink-200 p-12 text-center text-ink-500">
        لا توجد مقالات منشورة بعد.
      </p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    )}
  </section>
</BaseLayout>
