---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/lib/config";
import { jsonLd } from "@/lib/seo";

const posts = (await getCollection("posts", (p) => p.data.status === "published"))
  .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);

const featured = posts.filter((p) => p.data.featured).slice(0, 1)[0] ?? posts[0];
const latest = posts.filter((p) => p.id !== featured?.id).slice(0, 6);

const categories = (await getCollection("categories"))
  .sort((a, b) => a.data.order - b.data.order);

const author = (await getCollection("authors"))[0];

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: SITE.blogName,
  description: SITE.description,
  url: SITE.url,
  inLanguage: "ar",
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.mainSite },
};
---
<BaseLayout
  title={SITE.blogName}
  description={SITE.description}
  path="/"
  schemas={[siteSchema]}
>
  {/* Hero */}
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-bl from-brand-50 via-white to-white"></div>
    <div class="container-blog grid gap-10 py-16 md:py-24 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div class="flex flex-col justify-center">
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-brand-700 ring-1 ring-brand-200">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
          مدونة {SITE.name}
        </span>
        <h1 class="mt-5 text-3xl font-bold leading-[1.3] text-ink-900 md:text-5xl md:leading-[1.25]">
          {SITE.tagline}
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-500 md:text-lg">
          مقالات عربية عملية عن التسويق الرقمي، تطوير الأعمال، والهوية الرقمية — بلا حشو، وبأمثلة قابلة للتطبيق.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/blog"
            class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-600">
            استكشف المقالات <Icon name="arrowLeft" size={16} />
          </a>
          <a href={SITE.servicesUrl} target="_blank" rel="noopener"
            class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-ink-900 ring-1 ring-ink-200 transition-colors hover:ring-brand-500 hover:text-brand-600">
            استعرض الخدمات
          </a>
        </div>
      </div>

      {featured && (
        <div class="order-first lg:order-last">
          <PostCard post={featured} variant="wide" />
        </div>
      )}
    </div>
  </section>

  {/* التصنيفات */}
  {categories.length > 0 && (
    <section class="container-blog mt-4">
      <div class="flex items-end justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-ink-900 md:text-3xl">تصفح حسب التصنيف</h2>
          <p class="mt-1 text-sm text-ink-500">اختر المجال الذي يهمك</p>
        </div>
        <a href="/categories" class="hidden text-sm font-semibold text-brand-600 hover:underline md:inline-flex">
          كل التصنيفات ←
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((c) => (
          <a href={`/category/${c.data.slug}`}
            class="group flex flex-col justify-between rounded-2xl border border-ink-100 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-[var(--shadow-soft)]">
            <div>
              <div class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600">
                <Icon name="folder" size={20} />
              </div>
              <h3 class="mt-4 font-bold text-ink-900 group-hover:text-brand-600">{c.data.name}</h3>
              {c.data.description && (
                <p class="clamp-2 mt-1 text-sm text-ink-500">{c.data.description}</p>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* أحدث المقالات */}
  {latest.length > 0 && (
    <section class="container-blog mt-20">
      <div class="flex items-end justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-ink-900 md:text-3xl">أحدث المقالات</h2>
          <p class="mt-1 text-sm text-ink-500">جديد ما نشرناه</p>
        </div>
        <a href="/blog" class="hidden text-sm font-semibold text-brand-600 hover:underline md:inline-flex">
          كل المقالات ←
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}

  {/* عن الكاتب */}
  {author && (
    <section class="container-blog mt-20">
      <div class="grid gap-8 rounded-3xl border border-ink-100 bg-ink-50/50 p-8 md:grid-cols-[auto_1fr] md:p-10">
        <img
          src={author.data.avatar}
          alt={author.data.name}
          width="96"
          height="96"
          loading="lazy"
          class="h-24 w-24 rounded-2xl object-cover ring-4 ring-white"
        />
        <div>
          <p class="text-sm font-semibold text-brand-600">عن الكاتب</p>
          <h2 class="mt-1 text-2xl font-bold text-ink-900">{author.data.name}</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-ink-500">{author.data.bio}</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={`/author/${author.id}`}
              class="inline-flex items-center gap-2 rounded-xl bg-ink-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-600">
              الملف الكامل <Icon name="arrowLeft" size={16} />
            </a>
            <a href="/contact"
              class="inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-bold text-ink-900 ring-1 ring-ink-200 hover:ring-brand-500">
              تواصل معي
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* CTA */}
  <section class="container-blog mt-20">
    <div class="overflow-hidden rounded-3xl bg-gradient-to-bl from-brand-500 to-brand-700 p-10 text-white md:p-14">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold leading-snug md:text-4xl">
          جاهز لبناء حضورك الرقمي بشكل احترافي؟
        </h2>
        <p class="mt-4 text-white/85 md:text-lg">
          تعرّف على خدمات {SITE.name} في تطوير المواقع، تحسين محركات البحث، والحلول الرقمية.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={SITE.servicesUrl} target="_blank" rel="noopener"
            class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-brand-700 hover:bg-brand-50">
            استعرض الخدمات <Icon name="arrowLeft" size={16} />
          </a>
          <a href="/contact"
            class="inline-flex items-center gap-2 rounded-xl bg-white/15 px-5 py-3 text-sm font-bold text-white ring-1 ring-white/20 hover:bg-white/25">
            تواصل معي
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
