---
import { NAV, SITE } from "@/lib/config";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
---
<header
  id="site-header"
  class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-transparent transition-colors"
>
  <div class="container-blog flex h-16 items-center justify-between gap-4 md:h-18">
    <Logo />

    <nav class="hidden lg:flex items-center gap-1" aria-label="التنقل الرئيسي">
      {NAV.map((n) => (
        <a
          href={n.href}
          class="rounded-lg px-3 py-2 text-sm font-medium text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-600"
        >
          {n.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-2">
      <a
        href="/search"
        aria-label="بحث"
        class="grid h-10 w-10 place-items-center rounded-xl text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-600"
      >
        <Icon name="search" size={20} />
      </a>
      <a
        href={SITE.mainSite}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 rounded-xl bg-ink-900 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-600"
      >
        المتجر الرئيسي
        <Icon name="external" size={16} />
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="grid h-10 w-10 place-items-center rounded-xl text-ink-900 transition-colors hover:bg-brand-50 lg:hidden"
      aria-label="القائمة"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" size={22} />
    </button>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="border-t border-ink-100 bg-white lg:hidden"
  >
    <nav class="container-blog flex flex-col py-3" aria-label="التنقل للجوال">
      {NAV.map((n) => (
        <a
          href={n.href}
          class="rounded-lg px-3 py-3 text-base font-medium text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-600"
        >
          {n.label}
        </a>
      ))}
      <a
        href="/search"
        class="rounded-lg px-3 py-3 text-base font-medium text-ink-700 transition-colors hover:bg-brand-50"
      >
        بحث
      </a>
      <a
        href={SITE.mainSite}
        target="_blank"
        rel="noopener"
        class="mt-2 inline-flex items-center justify-center gap-1.5 rounded-xl bg-ink-900 px-4 py-3 text-base font-semibold text-white"
      >
        المتجر الرئيسي
        <Icon name="external" size={16} />
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const header = document.getElementById("site-header");

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.innerHTML = open
      ? '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>'
      : '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>';
  };

  toggle?.addEventListener("click", () =>
    setOpen(toggle.getAttribute("aria-expanded") !== "true")
  );

  // إغلاق القائمة عند تغيير الحجم إلى سطح المكتب
  const mq = window.matchMedia("(min-width: 1024px)");
  mq.addEventListener("change", (e) => e.matches && setOpen(false));

  // ظل خفيف عند التمرير فقط (غير مزعج)
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) header.classList.add("border-ink-100", "shadow-[0_1px_0_rgba(11,11,12,.02)]");
    else header.classList.remove("border-ink-100", "shadow-[0_1px_0_rgba(11,11,12,.02)]");
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
