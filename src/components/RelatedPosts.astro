---
import type { CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";
type Props = { posts: CollectionEntry<"posts">[]; title?: string };
const { posts, title = "مقالات ذات صلة" } = Astro.props;
---
{posts.length > 0 && (
  <section class="mt-14">
    <h2 class="mb-6 text-2xl font-bold text-ink-900">{title}</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.slice(0, 3).map((p) => <PostCard post={p} />)}
    </div>
  </section>
)}
