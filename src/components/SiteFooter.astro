---
import { SITE, NAV, LEGAL_LINKS } from "@/lib/config";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();

const categories = await getCollection("categories");
const topCategories = categories
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---
import { getCollection } from "astro:content";

<footer class="mt-24 border-t border-ink-100 bg-ink-50/50">
  <div class="container-blog grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <Logo />
      <p class="mt-4 text-sm leading-relaxed text-ink-500 max-w-xs">
        {SITE.description}
      </p>
      <div class="mt-5 flex items-center gap-2">
        <a href={SITE.mainSite} target="_blank" rel="noopener"
          class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-medium text-ink-700 ring-1 ring-ink-200 hover:text-brand-600">
          الموقع الرئيسي <Icon name="external" size={14} />
        </a>
      </div>
    </div>

    <div>
      <h3 class="text-sm font-bold text-ink-900 mb-4">المدونة</h3>
      <ul class="space-y-2 text-sm">
        {NAV.map((n) => (
          <li>
            <a href={n.href} class="text-ink-500 hover:text-brand-600 transition-colors">{n.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-bold text-ink-900 mb-4">تصنيفات</h3>
      <ul class="space-y-2 text-sm">
        {topCategories.map((c) => (
          <li>
            <a href={`/category/${c.data.slug}`} class="text-ink-500 hover:text-brand-600 transition-colors">
              {c.data.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-bold text-ink-900 mb-4">قانوني</h3>
      <ul class="space-y-2 text-sm">
        {LEGAL_LINKS.map((l) => (
          <li>
            <a href={l.href} class="text-ink-500 hover:text-brand-600 transition-colors">{l.label}</a>
          </li>
        ))}
        <li>
          <a href="/faq" class="text-ink-500 hover:text-brand-600 transition-colors">الأسئلة الشائعة</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-100">
    <div class="container-blog flex flex-col items-center justify-between gap-3 py-6 text-xs text-ink-500 md:flex-row">
      <p>© {year} {SITE.name} — جميع الحقوق محفوظة.</p>
      <p class="flex items-center gap-1.5">
        <span>صُنع بعناية في</span>
        <a href={SITE.mainSite} class="text-brand-600 font-semibold hover:underline" target="_blank" rel="noopener">
          abdallahabas.com
        </a>
      </p>
    </div>
  </div>
</footer>
